---
interface Props {
  services: {
    title: string
    description: string
  }[]
}

const { services } = Astro.props
---

<section id="services" class="py-28 px-6 bg-[var(--color-white)]">
  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="max-w-lg mb-14">
      <p class="text-xs font-semibold tracking-widest uppercase text-[var(--color-teal)] mb-2">
        What We Offer
      </p>
      <h2 class="font-display text-4xl font-bold text-[var(--color-navy)] leading-tight mb-3">
        Comprehensive Dental Services
      </h2>
      <p class="text-[var(--color-gray)] text-base leading-relaxed">
        From routine cleanings to full smile makeovers — we handle it all under one roof.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map(service => (
        <div class="bg-white border border-[var(--color-gray-light)] rounded-2xl p-7 transition-all duration-200 hover:border-[var(--color-teal)] hover:shadow-[var(--shadow-elevated)] hover:-translate-y-1 cursor-pointer group">
          <h3 class="font-bold text-[var(--color-navy)] text-base mb-2">
            {service.title}
          </h3>
          <p class="text-[var(--color-gray)] text-sm leading-relaxed mb-4">
            {service.description}
          </p>
          <span class="text-xs font-semibold text-[var(--color-teal)] group-hover:underline">
            Learn more →
          </span>
        </div>
      ))}
    </div>

  </div>
</section>