---
interface Props {
  label: string
  href?: string
  variant?: 'primary' | 'outline' | 'ghost'
  size?: 'sm' | 'md' | 'lg'
}

const {
  label,
  href,
  variant = 'primary',
  size = 'md',
} = Astro.props

const base = 'inline-flex items-center justify-center rounded-full font-semibold transition-all duration-200 cursor-pointer border-2'

const variants = {
  primary: 'bg-[var(--color-teal)] text-[var(--color-navy)] border-transparent hover:brightness-110 hover:-translate-y-px',
  outline: 'bg-transparent border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white',
  ghost:   'bg-transparent border-[var(--color-teal)] text-[var(--color-teal)] hover:bg-[var(--color-teal-light)]',
}

const sizes = {
  sm: 'text-sm px-5 py-2',
  md: 'text-sm px-7 py-3',
  lg: 'text-base px-9 py-4',
}

const classes = `${base} ${variants[variant]} ${sizes[size]}`
---

{href
  ? <a href={href} class={classes}>{label}</a>
  : <button class={classes}>{label}</button>
}